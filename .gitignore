# live-build 在本目录内就地构建，产物与状态都落在源码旁边。

# 构建状态与产物
/.build/
/.lock
/binary/
/chroot/
/cache/
/binary.modified_timestamps
/build_exit_code
*.log

# 镜像及其清单
*.iso
*.files
*.packages
*.contents

# lb config 每次构建重新生成的文件
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/environment.chroot_hooks

# live-build 自带钩子，lb config 以符号链接放入
config/hooks/**/*.hook.chroot
config/hooks/**/*.hook.binary

# 测试镜像的叠加层由 scripts/90-mk-test-iso.sh 临时铺进 includes.chroot_after_packages，
# 构建结束即撤除。目录本身要纳管，铺进去的副本不要。
/config/includes.chroot_after_packages/etc/vyatta/dataplane.conf
