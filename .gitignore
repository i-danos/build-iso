# live-build builds in place in this directory, so artifacts and state land
# alongside the sources.

# Build state and artifacts
/.build/
/.lock
/binary/
/chroot/
/cache/
/binary.modified_timestamps
/build_exit_code
*.log

# Images and their manifests
*.iso
*.files
*.packages
*.contents

# Regenerated by lb config on every build
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/environment.chroot_hooks

# live-build's own hooks, symlinked in by lb config
config/hooks/**/*.hook.chroot
config/hooks/**/*.hook.binary

# scripts/90-mk-test-iso.sh stages the test overlay into
# includes.chroot_after_packages for the duration of a build and removes it
# afterwards. Track the directory itself, not the staged copy.
/config/includes.chroot_after_packages/etc/vyatta/dataplane.conf

# Written by lb build at the end of a run: the package manifests for the two
# install passes, and the source-stage directory. Regenerated every build.
/chroot.packages.install
/chroot.packages.live
/config/source/
