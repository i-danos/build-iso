# Build time only: live-build uses this as the chroot's apt source, and
# config/hooks/normal/0990-create-chroot-fs.chroot reads it when creating the
# CLI sandbox. The /etc/apt/sources.list inside the ISO is generated separately
# from LB_MIRROR_BINARY, still points at deb.debian.org, and is unaffected.
#
# Aliyun is used because deb.debian.org measures only 30 KB/s from this host
# against Aliyun's 2 MB/s — roughly 68x, the difference between a build taking
# tens of minutes and taking hours.
deb http://mirrors.aliyun.com/debian/ trixie main contrib non-free non-free-firmware
deb http://mirrors.aliyun.com/debian-security/ trixie-security main contrib non-free non-free-firmware
deb http://mirrors.aliyun.com/debian/ trixie-updates main contrib non-free non-free-firmware
