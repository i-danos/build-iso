#!/bin/sh

if [ ! -f /etc/os-release.vyatta ] ; then
    exit 0
fi

echo "I: running hook $(basename ${0})"

# we should get this from vyatta-version
ln -fs /etc/os-release.vyatta /etc/os-release

[ -f /live-build/config/environment.chroot_hooks ] && . /live-build/config/environment.chroot_hooks

# Replace a key rather than append it. vyatta-version already ships
# VYATTA_PROJECT_ID in os-release.vyatta, so appending left the file with two
# of them. Parsers take the last assignment, which happened to be ours, so the
# banner was right by luck -- and the same collision in the other order once
# degraded it to "DANOS (Lancaster) 2608 (Lancaster)".
#
# /etc/os-release is a symlink to os-release.vyatta and "sed -i" would replace
# the link with a regular file, so resolve it and edit the target.
set_os_release_key()
{
    _target="$(readlink -f /etc/os-release)"
    sed -i "/^${1}=/d" "${_target}"
    printf '%s="%s"\n' "${1}" "${2}" >> "${_target}"
}

if [ -n "${VARIANT}" ]; then
    set_os_release_key VARIANT "${VARIANT}"
    set_os_release_key VARIANT_ID "${VARIANT_ID}"
fi

if [ -n "${BUILD_TIME}" ] ; then
    BUILD_ID="$(date +%Y%m%dT%H%M -d @$BUILD_TIME)-${RECIPEFILE}"
fi

set_os_release_key BUILD_ID "${BUILD_ID}"
set_os_release_key VYATTA_PROJECT_ID "${PROJECT_ID}"
