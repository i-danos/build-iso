#!/bin/sh
#
# Disable the CLI sandbox / user-isolation PAM profile.
#
# pam-sandbox's postinst enables the profile unconditionally:
#
#     cp -f /opt/vyatta/share/pam-configs/sandbox /usr/share/pam-configs/
#     pam-auth-update --package
#
# which puts "session required pam_sandbox.so" into /etc/pam.d/common-session.
# pam_sandbox then tries, for every non-root user outside the vyattasu group,
# to start a per-user systemd-nspawn container via systemd-machined and join
# its namespaces. On trixie (systemd 257 / kernel 6.12) that fails, and because
# the module is "required" the whole session is refused -- so the live ISO's
# tmpuser autologin dies immediately and getty respawns in a loop instead of
# reaching a vbash prompt.
#
# This runs the same sequence as DANOS's own supported off switch,
# tmplscripts/system/login/user_isolation.sh "disable". Note it deliberately
# leaves /opt/vyatta/share/pam-configs/sandbox in place, which is where that
# script copies the profile back from -- so "system login user-isolation" can
# re-enable the feature at runtime once the sandbox works under trixie,
# without rebuilding the image.

set -e

echo "I: running hook $(basename ${0})"

[ -f /usr/share/pam-configs/sandbox ] || exit 0

DEBIAN_FRONTEND=noninteractive pam-auth-update --package --remove sandbox
rm -f /usr/share/pam-configs/sandbox

echo "I: user isolation (pam_sandbox) disabled"
