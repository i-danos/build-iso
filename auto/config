#!/bin/sh
#
# This is the live-build 3.x auto/config
#

set -e

: ${TOPDIR:=/usr/src/packages}

get_prjconf_parameter()
{
    PARAM=$1
    BUILDCONFIG="/.build/build.dist"

    if [ ! -e $BUILDCONFIG ] && [ -d $TOPDIR/SOURCES ]
    then
        BUILDCONFIG=$( ls -1 $TOPDIR/SOURCES/_buildconfig* 2>/dev/null | head -n1 || true )
    fi

    if [ -n "$BUILDCONFIG" ] && [ -e "$BUILDCONFIG" ]
    then
        grep -E "^%$PARAM " $BUILDCONFIG | sed "s/^%$PARAM //g" | tail -n1
    else
        echo "vyatta"
    fi
}

# default to the parent directory name
: ${RECIPEFILE:="$(basename $(pwd))"}
# for reproducible builds
if [ ! -z "$SOURCE_DATE_EPOCH" ]; then
    BUILD_TIME="$SOURCE_DATE_EPOCH"
else
    BUILD_TIME="$(date +%s)"
fi

BUILDSTAMP="$(date +"%Y%m%dT%H%M" -d @$BUILD_TIME)"

# VYATTA_PROJECT_ID is the build stamp shown as the trailing bracket of
# "show version", e.g. DANOS (Kington) 2111 (DANOS:Shipping:2111:20260820).
# It is not the codename: _project holds that, and it already reaches
# os-release through PRETTY_NAME. Passing the codename here produced a
# second VYATTA_PROJECT_ID line in /etc/os-release that shadowed the
# correct one vyatta-version had written, and the banner degenerated to
# "DANOS (Kington) 2111 (Kington)".
PROJECT_STAMP_DATE=$(date -u +'%Y%m%d' -d @${BUILD_TIME})
PROJECT_ID="$(get_prjconf_parameter _vyatta_pretty_name):Shipping:$(get_prjconf_parameter _vyatta_version_id):${PROJECT_STAMP_DATE}"

# create environment file read by chroot hooks -- truncated, not appended:
# the hooks source it and the last assignment wins, so appending each build
# only grew the file without changing behaviour.
cat <<EOF > config/environment.chroot_hooks
BUILD_TIME="${BUILD_TIME}"
PROJECT_ID="${PROJECT_ID}"
RECIPEFILE="${RECIPEFILE}"
EOF

IMAGE_NAME="${RECIPEFILE%.livebuild}_${BUILDSTAMP}"

LINUX_FLAVOURS=$(grep -s -h linux-image config/package-lists/*.chroot | grep -v '^#' | sed "s/linux-image-//g")

if [ -z "$LINUX_FLAVOURS" ]; then
    LINUX_FLAVOURS="vyatta"
fi

ISO_APPLICATION=$(get_prjconf_parameter _vyatta_pretty_name)
ISO_PUBLISHER=$(get_prjconf_parameter _vyatta_name)
ISO_VOLUME=$(get_prjconf_parameter _vyatta_version_id)

ONIE=$(get_prjconf_parameter _onie)
if [ "$ONIE" != "true" ] && [ "$ONIE" != "false" ]; then
    echo "Unknown _onie value '$ONIE', using 'false'"
    ONIE="false"
fi

# bootstrap/chroot 取包走阿里云镜像：本机到 deb.debian.org 实测约 30 KB/s，
# 阿里云约 2 MB/s，相差约 68 倍，直接决定构建是几十分钟还是若干小时。
# binary 镜像保持 deb.debian.org —— 那是写进 ISO 内 sources.list 的地址，
# 产品不应携带地域性镜像。改这里而不是 config/bootstrap，是因为 lb build
# 会先跑 lb config 重新生成 config/bootstrap，手工编辑那个文件会被覆盖。
lb config noauto \
    --apt apt \
    --apt-indices false \
    --apt-options "--yes --allow-downgrades -o Acquire::Check-Valid-Until=false -o Acquire::Languages=none" \
    --apt-recommends false \
    --apt-source-archives false \
    --backports false \
    --build-with-chroot true \
    --cache-indices false \
    --checksums "md5 sha256" \
    --chroot-filesystem squashfs \
    --debconf-frontend noninteractive \
    --debian-installer none \
    --distribution trixie \
    --debian-installer-distribution trixie \
    --parent-debian-installer-distribution trixie \
    --mirror-bootstrap http://mirrors.aliyun.com/debian/ \
    --mirror-binary http://deb.debian.org/debian/ \
    --mirror-binary-security http://deb.debian.org/debian-security/ \
    --mirror-chroot http://mirrors.aliyun.com/debian/ \
    --mirror-chroot-security http://mirrors.aliyun.com/debian-security/ \
    --parent-mirror-binary http://deb.debian.org/debian/ \
    --parent-mirror-binary-security http://deb.debian.org/debian-security/ \
    --parent-mirror-chroot http://mirrors.aliyun.com/debian/ \
    --parent-mirror-chroot-security http://mirrors.aliyun.com/debian-security/ \
    --parent-mirror-debian-installer http://deb.debian.org/debian/ \
    --mirror-debian-installer http://deb.debian.org/debian/ \
    --archive-areas "main contrib non-free non-free-firmware" \
    --parent-archive-areas "main contrib non-free non-free-firmware" \
    --keyring-packages "debian-archive-keyring" \
    --debootstrap-options "--keyring=/usr/share/keyrings/debian-archive-keyring.gpg" \
    --firmware-binary false \
    --firmware-chroot false \
    --ignore-system-defaults \
    --image-name "${IMAGE_NAME}" \
    --initramfs live-boot \
    --iso-application "${ISO_APPLICATION}" \
    --iso-publisher "${ISO_PUBLISHER}" \
    --iso-volume "${ISO_VOLUME}" \
    --linux-flavours "${LINUX_FLAVOURS}" \
    --mode debian \
    --parent-distribution trixie \
    --security true \
    --source false \
    --updates false \
    --verbose \
    --onie "${ONIE}" \
    --onie-kernel-cmdline "systemd.show_status=1 net.ifnames=1 vyatta-autoinstall" \
    "${@}"
