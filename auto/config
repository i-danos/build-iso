#!/bin/sh
#
# This is the live-build 3.x auto/config
#

set -e

: ${TOPDIR:=/usr/src/packages}

get_prjconf_parameter()
{
    PARAM=$1
    BUILDCONFIG="/.build/build.dist"

    if [ ! -e $BUILDCONFIG ] && [ -d $TOPDIR/SOURCES ]
    then
        BUILDCONFIG=$( ls -1 $TOPDIR/SOURCES/_buildconfig* 2>/dev/null | head -n1 || true )
    fi

    if [ -n "$BUILDCONFIG" ] && [ -e "$BUILDCONFIG" ]
    then
        grep -E "^%$PARAM " $BUILDCONFIG | sed "s/^%$PARAM //g" | tail -n1
    else
        echo "vyatta"
    fi
}

# The image name, fixed rather than taken from the directory. It used to
# default to "$(basename $(pwd))", which meant renaming the checkout silently
# renamed the ISO: the tree moved to danos-sources/build-iso and the next build
# would have produced build-iso_<stamp>.iso. Still overridable from the
# environment for a one-off build.
: ${RECIPEFILE:="i-danos"}
# for reproducible builds
if [ ! -z "$SOURCE_DATE_EPOCH" ]; then
    BUILD_TIME="$SOURCE_DATE_EPOCH"
else
    BUILD_TIME="$(date +%s)"
fi

BUILDSTAMP="$(date +"%Y%m%dT%H%M" -d @$BUILD_TIME)"

# VYATTA_PROJECT_ID is the build stamp shown as the trailing bracket of
# "show version", e.g. DANOS (Lancaster) 2608 (DANOS:Shipping:2608:20260902).
# It is not the codename: _project holds that, and it already reaches
# os-release through PRETTY_NAME. Passing the codename here produced a
# second VYATTA_PROJECT_ID line in /etc/os-release that shadowed the
# correct one vyatta-version had written, and the banner degenerated to
# "DANOS (Lancaster) 2608 (Lancaster)".
PROJECT_STAMP_DATE=$(date -u +'%Y%m%d' -d @${BUILD_TIME})
# The release id, from %_vyatta_version_id in build.dist. Read once: it names
# the ISO, the ISO volume and the trailing bracket of "show version", and those
# three disagreeing is exactly the kind of thing nobody notices.
VERSION_ID=$(get_prjconf_parameter _vyatta_version_id)
PROJECT_ID="$(get_prjconf_parameter _vyatta_pretty_name):Shipping:${VERSION_ID}:${PROJECT_STAMP_DATE}"

# create environment file read by chroot hooks -- truncated, not appended:
# the hooks source it and the last assignment wins, so appending each build
# only grew the file without changing behaviour.
cat <<EOF > config/environment.chroot_hooks
BUILD_TIME="${BUILD_TIME}"
PROJECT_ID="${PROJECT_ID}"
RECIPEFILE="${RECIPEFILE}"
EOF

IMAGE_NAME="${RECIPEFILE%.livebuild}_${VERSION_ID}_${BUILDSTAMP}"

LINUX_FLAVOURS=$(grep -s -h linux-image config/package-lists/*.chroot | grep -v '^#' | sed "s/linux-image-//g")

if [ -z "$LINUX_FLAVOURS" ]; then
    LINUX_FLAVOURS="vyatta"
fi

ISO_APPLICATION=$(get_prjconf_parameter _vyatta_pretty_name)
ISO_PUBLISHER=$(get_prjconf_parameter _vyatta_name)
ISO_VOLUME="${VERSION_ID}"

ONIE=$(get_prjconf_parameter _onie)
if [ "$ONIE" != "true" ] && [ "$ONIE" != "false" ]; then
    echo "Unknown _onie value '$ONIE', using 'false'"
    ONIE="false"
fi

# bootstrap/chroot fetch packages from a regional mirror, for speed: measured
# from this host, deb.debian.org runs at about 7.5 MB/s against Tsinghua's
# 14 MB/s, and the difference over a whole chroot is tens of minutes.
#
# Tsinghua rather than Aliyun, which this used and which broke the build.
# Aliyun's trixie was two months stale -- Release dated 11 July against
# 12 September everywhere else -- so it served perl 5.40.1-6 while the point
# release had moved trixie/main to 5.40.1-6+deb13u1. Packages OBS builds
# against current Debian then cannot install:
#
#     libvci-perl : Depends: perl (>= 5.40.1-6+deb13u1)
#                   but 5.40.1-6 is to be installed
#
# which apt reports as held broken packages, naming perl and not the mirror.
# It had been survivable only because nothing on OBS had yet been rebuilt
# against the newer perl.
#
# A mirror is a cache with no obligation to be current, so any replacement
# needs checking rather than trusting. Tsinghua, USTC and Huawei all carried
# a Release timestamp identical to deb.debian.org's when this was changed;
# Aliyun did not.
#
# The binary mirror stays on deb.debian.org, since that address is written into
# the sources.list inside the ISO and the product should not carry a regional
# mirror. Set here rather than in config/bootstrap because lb build runs
# lb config first and regenerates that file, discarding hand edits.
lb config noauto \
    --apt apt \
    --apt-indices false \
    --apt-options "--yes --allow-downgrades -o Acquire::Check-Valid-Until=false -o Acquire::Languages=none" \
    --apt-recommends false \
    --apt-source-archives false \
    --backports false \
    --build-with-chroot true \
    --cache-indices false \
    --checksums "md5 sha256" \
    --chroot-filesystem squashfs \
    --debconf-frontend noninteractive \
    --debian-installer none \
    --distribution trixie \
    --debian-installer-distribution trixie \
    --parent-debian-installer-distribution trixie \
    --mirror-bootstrap http://mirrors.tuna.tsinghua.edu.cn/debian/ \
    --mirror-binary http://deb.debian.org/debian/ \
    --mirror-binary-security http://deb.debian.org/debian-security/ \
    --mirror-chroot http://mirrors.tuna.tsinghua.edu.cn/debian/ \
    --mirror-chroot-security http://mirrors.tuna.tsinghua.edu.cn/debian-security/ \
    --parent-mirror-binary http://deb.debian.org/debian/ \
    --parent-mirror-binary-security http://deb.debian.org/debian-security/ \
    --parent-mirror-chroot http://mirrors.tuna.tsinghua.edu.cn/debian/ \
    --parent-mirror-chroot-security http://mirrors.tuna.tsinghua.edu.cn/debian-security/ \
    --parent-mirror-debian-installer http://deb.debian.org/debian/ \
    --mirror-debian-installer http://deb.debian.org/debian/ \
    --archive-areas "main contrib non-free non-free-firmware" \
    --parent-archive-areas "main contrib non-free non-free-firmware" \
    --keyring-packages "debian-archive-keyring" \
    --debootstrap-options "--keyring=/usr/share/keyrings/debian-archive-keyring.gpg" \
    --firmware-binary false \
    --firmware-chroot false \
    --ignore-system-defaults \
    --image-name "${IMAGE_NAME}" \
    --initramfs live-boot \
    --iso-application "${ISO_APPLICATION}" \
    --iso-publisher "${ISO_PUBLISHER}" \
    --iso-volume "${ISO_VOLUME}" \
    --linux-flavours "${LINUX_FLAVOURS}" \
    --mode debian \
    --parent-distribution trixie \
    --security true \
    --source false \
    --updates false \
    --verbose \
    --onie "${ONIE}" \
    --onie-kernel-cmdline "systemd.show_status=1 net.ifnames=1 vyatta-autoinstall" \
    "${@}"
